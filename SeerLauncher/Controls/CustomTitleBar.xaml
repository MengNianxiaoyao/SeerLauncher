<UserControl x:Class="SeerLauncher.Controls.CustomTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32">
    <Border Background="{StaticResource CardBgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="12,0,0,0"
                       FontFamily="宋体" FontSize="14" Foreground="{StaticResource TextBrush}"
                       Text="{Binding Title, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
            <Button Grid.Column="1" Style="{StaticResource CaptionCloseButtonStyle}" Content="✕"
                    WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseBtn_Click"/>
        </Grid>
    </Border>
</UserControl>
