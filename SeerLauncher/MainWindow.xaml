<Window x:Class="SeerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="赛尔号辅助启动器" Width="880" Height="600"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Icon="ico.ico"
        Background="{StaticResource WindowBgBrush}">
    <Window.Resources>
        <ContextMenu x:Key="ProgramsContextMenu">
            <MenuItem x:Name="CtxRefreshProgram" Header="刷新显示" Click="RefreshMenu_Click"/>
            <MenuItem x:Name="CtxAddProgram" Header="添加程序" Click="AddProgramMenu_Click"/>
            <MenuItem x:Name="CtxLaunchProgram" Header="启动程序" Click="LaunchProgramMenu_Click"/>
            <MenuItem x:Name="CtxDeleteProgram" Header="删除程序" Click="DeleteProgramMenu_Click"/>
            <MenuItem x:Name="CtxOpenDir" Header="打开所在目录" Click="OpenDirMenu_Click"/>
        </ContextMenu>
        <ContextMenu x:Key="KeywordsContextMenu">
            <MenuItem x:Name="CtxRefreshKeyword" Header="刷新" Click="RefreshMenu_Click"/>
            <MenuItem x:Name="CtxAddKeyword" Header="添加关键字" Click="AddKeywordMenu_Click"/>
            <MenuItem x:Name="CtxModifyKeyword" Header="修改关键字" Click="ModifyKeywordMenu_Click"/>
            <MenuItem x:Name="CtxDeleteKeyword" Header="删除关键字" Click="DeleteKeywordMenu_Click"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 工具栏 -->
        <Border Grid.Row="0" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="赛尔号辅助启动器" FontSize="16" FontWeight="Bold"
                           VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                <Button Grid.Column="1" Content="辅助下载" Margin="6,0,0,0" Click="AuxDownload_Click"/>
                <Button Grid.Column="2" Content="检查更新" Margin="6,0,0,0" Click="CheckUpdate_Click"/>
                <Button Grid.Column="3" Content="程序说明" Margin="6,0,0,0" Click="Instructions_Click"/>
                <Button Grid.Column="4" Content="关于开发者" Margin="6,0,0,0" Click="Developer_Click"/>
                <Button Grid.Column="5" Content="商店" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="14,0,0,0" Click="Store_Click"/>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 关键字卡片 -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="关键字" FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"/>
                    <ListBox x:Name="KeywordList" Grid.Row="1"
                             ItemsSource="{Binding Keywords}"
                             SelectedItem="{Binding SelectedKeyword}"
                             ContextMenu="{StaticResource KeywordsContextMenu}"
                             PreviewMouseRightButtonDown="KeywordList_PreviewMouseRightButtonDown"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="添加" Click="AddKeywordMenu_Click" Margin="0,0,6,0"/>
                        <Button Content="修改" Click="ModifyKeywordMenu_Click" Margin="0,0,6,0"/>
                        <Button Content="删除" Click="DeleteKeywordMenu_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 程序卡片 -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="程序" FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"/>
                    <ListBox x:Name="ProgramsList" Grid.Row="1"
                             ItemsSource="{Binding Programs}"
                             SelectedItem="{Binding SelectedProgram}"
                             ContextMenu="{StaticResource ProgramsContextMenu}"
                             AllowDrop="True"
                             DragOver="ProgramsList_DragOver"
                             Drop="ProgramsList_Drop"
                             MouseDoubleClick="ProgramsList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="ProgramsList_PreviewMouseRightButtonDown"/>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="刷新显示" Click="RefreshMenu_Click" Margin="0,0,6,0"/>
                        <Button Content="添加程序" Click="AddProgramMenu_Click" Margin="0,0,6,0"/>
                        <Button Content="启动程序" Click="LaunchProgramMenu_Click" Margin="0,0,6,0"/>
                        <Button Content="删除程序" Click="DeleteProgramMenu_Click" Margin="0,0,6,0"/>
                        <Button Content="打开目录" Click="OpenDirMenu_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="2" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <TextBlock x:Name="VersionBar" FontSize="12" Foreground="{StaticResource MutedTextBrush}"/>
        </Border>
    </Grid>
</Window>