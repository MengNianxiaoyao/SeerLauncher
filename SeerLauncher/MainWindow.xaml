<local:BaseWindow x:Class="SeerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SeerLauncher.Controls"
        xmlns:local="clr-namespace:SeerLauncher"
        Title="赛尔号辅助启动器" Width="880" Height="600"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Icon="icon.ico"
        Background="{StaticResource WindowBgBrush}">
    <WindowChrome.WindowChrome>
        <StaticResource ResourceKey="AppWindowChrome"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <ContextMenu x:Key="ProgramsContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem x:Name="CtxRefreshProgram" Header="刷新显示"
                      Command="{Binding RefreshDisplayCommand}"/>
            <MenuItem x:Name="CtxAddProgram" Header="添加程序"
                      Command="{Binding Programs.AddCommand}"/>
            <MenuItem x:Name="CtxLaunchProgram" Header="启动程序"
                      Command="{Binding Programs.LaunchCommand}"/>
            <MenuItem x:Name="CtxDeleteProgram" Header="删除程序"
                      Command="{Binding Programs.DeleteCommand}"/>
            <MenuItem x:Name="CtxOpenDir" Header="打开所在目录"
                      Command="{Binding Programs.OpenDirectoryCommand}"/>
        </ContextMenu>
        <ContextMenu x:Key="KeywordsContextMenu"
                     DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
            <MenuItem x:Name="CtxRefreshKeyword" Header="刷新"
                      Command="{Binding RefreshDisplayCommand}"/>
            <MenuItem x:Name="CtxAddKeyword" Header="添加关键字"
                      Command="{Binding Keywords.AddCommand}"/>
            <MenuItem x:Name="CtxModifyKeyword" Header="修改关键字"
                      Command="{Binding Keywords.ModifyCommand}"/>
            <MenuItem x:Name="CtxDeleteKeyword" Header="删除关键字"
                      Command="{Binding Keywords.DeleteCommand}"/>
        </ContextMenu>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 标题栏 -->
        <controls:CustomTitleBar Grid.Row="0" Title="赛尔号辅助启动器" ShowMinimizeButton="True">
            <controls:CustomTitleBar.Icon>
                <BitmapImage UriSource="pack://application:,,,/icon.ico" DecodePixelWidth="16"/>
            </controls:CustomTitleBar.Icon>
        </controls:CustomTitleBar>

        <!-- 工具栏 -->
        <Border Grid.Row="1" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="脱机下载" Margin="6,0,0,0" Command="{Binding Updates.AuxiliaryDownloadCommand}"/>
                <Button Grid.Column="1" Content="检查更新" Margin="6,0,0,0" Command="{Binding Updates.CheckUpdateCommand}"/>
                <Button Grid.Column="2" Content="程序说明" Margin="6,0,0,0" Command="{Binding Updates.OpenInstructionsCommand}"/>
                <Button Grid.Column="3" Content="关于开发者" Margin="6,0,0,0" Command="{Binding Updates.OpenBilibiliCommand}"/>
                <Button Grid.Column="4" Content="商店" Style="{StaticResource PrimaryButtonStyle}"
                        Margin="14,0,0,0" Command="{Binding Updates.OpenStoreCommand}"/>
            </Grid>
        </Border>

        <!-- 内容区 -->
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- 关键字卡片 -->
            <Border Grid.Column="0" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="关键字" FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"/>
                    <ListBox x:Name="KeywordList" Grid.Row="1"
                             ItemsSource="{Binding Keywords.Items}"
                             SelectedItem="{Binding Keywords.SelectedItem}"
                             ContextMenu="{StaticResource KeywordsContextMenu}"
                             PreviewMouseRightButtonDown="KeywordList_PreviewMouseRightButtonDown"/>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="添加" Command="{Binding Keywords.AddCommand}" Margin="0,0,6,0"/>
                        <Button Content="修改" Command="{Binding Keywords.ModifyCommand}" Margin="0,0,6,0"/>
                        <Button Content="删除" Command="{Binding Keywords.DeleteCommand}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 程序卡片 -->
            <Border Grid.Column="2" Background="{StaticResource CardBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="程序" FontSize="15" FontWeight="SemiBold"
                               Margin="0,0,0,8" Foreground="{StaticResource TextBrush}"/>
                    <ListBox x:Name="ProgramsList" Grid.Row="1"
                             ItemsSource="{Binding Programs.Items}"
                             SelectedItem="{Binding Programs.SelectedItem}"
                             ContextMenu="{StaticResource ProgramsContextMenu}"
                             AllowDrop="True"
                             DragOver="ProgramsList_DragOver"
                             Drop="ProgramsList_Drop"
                             MouseDoubleClick="ProgramsList_MouseDoubleClick"
                             PreviewMouseRightButtonDown="ProgramsList_PreviewMouseRightButtonDown"/>
                    <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="刷新显示" Command="{Binding RefreshDisplayCommand}" Margin="0,0,6,0"/>
                        <Button Content="启动程序" Command="{Binding Programs.LaunchCommand}" Margin="0,0,6,0"/>
                        <Button Content="添加程序" Command="{Binding Programs.AddCommand}" Margin="0,0,6,0"/>
                        <Button Content="删除程序" Command="{Binding Programs.DeleteCommand}" Margin="0,0,6,0"/>
                        <Button Content="打开目录" Command="{Binding Programs.OpenDirectoryCommand}"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- 状态栏 -->
        <Border Grid.Row="3" Background="{StaticResource CardBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding Updates.VersionText}" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"/>
                <TextBlock Grid.Column="1" Text="开发者：梦念逍遥" FontSize="12"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </Grid>
        </Border>
    </Grid>
</local:BaseWindow>
