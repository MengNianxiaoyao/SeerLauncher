<Window x:Class="SeerLauncher.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="输入" Width="400" Height="200"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F4F6FB">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="PromptText" Grid.Row="0" Margin="0,0,0,10" FontSize="13" Foreground="#1F2937"/>
        <TextBox x:Name="InputBox" Grid.Row="1" FontSize="14" VerticalContentAlignment="Center" Padding="8,4"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="确定" Width="80" Height="34" Click="OnOk" IsDefault="True"/>
            <Button Content="取消" Width="80" Height="34" Margin="10,0,0,0" Click="OnCancel" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>